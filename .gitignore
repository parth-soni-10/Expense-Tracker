# Freebuff (local app / assistant data — do NOT upload)
.freebuff/

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/

# Env / secrets
.env
.env.local
.env.*.local

# The Lidl spike's output folder — credentials, refresh token and pulled
# receipts. It lives in the repo so the paths are simple, but nothing inside
# may ever be committed (mirrored in .assetsignore so the deploy never serves
# it either).
lidl-spike-out/

# Python bytecode (the spikes are stdlib-only, but importing one in a test
# leaves this behind). .assetsignore already keeps it off the deploy.
__pycache__/
*.pyc

# Logs
*.log

# Test files — development-only, never ship or commit
/testing/

# Build outputs (when scaffolding the real app)
node_modules/
dist/
build/

# Netlify
.netlify/

# Local Worker secrets for `wrangler dev` (never committed; .assetsignore too).
.dev.vars

# `wrangler dev`'s local state directory (KV and cache under miniflare).
.wrangler/

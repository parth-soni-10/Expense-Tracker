# Freebuff (local app / assistant data — do NOT upload)
.freebuff/

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/

# Env / secrets
.env
.env.local
.env.*.local

# Logs
*.log

# Test files — development-only, never ship or commit
/testing/

# Build outputs (when scaffolding the real app)
node_modules/
dist/
build/

# Netlify
.netlify/

# Local secrets for a local run, `wrangler pages dev` included (never
# committed; .assetsignore too).
.dev.vars

# Wrangler's local state directory (KV and cache under miniflare).
.wrangler/

# Deploy staging output, written by tools/deploy-pages.mjs. Build output; also
# listed in .assetsignore, so it can never be uploaded even by hand.
.pages-dist/

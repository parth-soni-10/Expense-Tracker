# Response headers for Cents.
#
# This is the whole header set: the repo has no netlify.toml any more, and the
# assets directory is the repository root, so one /* block covers the page, the
# function routes and every asset.
#
# Cloudflare's `*` in a `_headers` path spans slashes, so `/*.js` covers
# /vendor/sweetalert2.min.js — verified against the deployed Content Tracker,
# where the `/*.png` rule answers for /icons/icon-192.png. That matters here
# because every rule below is written the way netlify.toml's were.
#
# The path rules exist for the same reason they did there: nothing in this app
# carries a content hash in its filename, so nothing may be cached
# indefinitely — a changed file has to reach a returning visitor, and a redeploy
# that the browser answers from its own cache is the failure this project has
# already hit twice. `no-cache, must-revalidate` keeps it a cheap 304, never a
# stale build.
#
# Content-Type is pinned where the platform's default is not something to bet
# the feature on: the roster OCR's WebAssembly (a mislabelled .wasm is refused
# by the streaming compiler), the 2.9 MB language model, the install manifest,
# and the Digital Asset Links file a verified app package needs. The text types
# are left to the asset layer, which labels them utf-8 already — this file used
# to restate text/javascript and text/css for a Latin-1 fallback that Cloudflare
# does not have.

# Preview deployments add a hostname label before the project name. Keep those
# URLs out of search without matching the production cents-app.pages.dev host.
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

/*.js
  Cache-Control: no-cache, must-revalidate

/*.css
  Cache-Control: no-cache, must-revalidate

# The vendored kit's lockfile: it is not matched by /*.js, and the platform's
# default would let a changed lock sit in a browser's cache.
/ui-kit.lock.json
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

# The 404 page, on the same footing as the two rules above: it is a page of the
# site, so it revalidates rather than waiting out the platform's own week. It
# exists (rather than being left to Cloudflare's generic error page, which was
# the response an unknown path used to get) because Pages answers `200` with
# index.html for every unmatched path when the upload carries no 404.html.
/404.html
  Cache-Control: no-cache, must-revalidate

# Self-hosted fonts (see @font-face in styles.css). Covered explicitly rather
# than left to the platform default: this is the class of file a browser will
# happily keep for a year if nothing says otherwise, and a stale font is
# invisible until it is the wrong glyph.
/fonts/*
  Cache-Control: no-cache, must-revalidate

# The roster-OCR language model: an explicit type for the same reason as the
# wasm rule below, and no-cache so a model swap is never masked — the 2.9 MB
# revalidates as a cheap 304 rather than being re-downloaded.
/vendor/tesseract/*.gz
  Content-Type: application/gzip
  Cache-Control: no-cache, must-revalidate

# WebAssembly core for the roster OCR. `Content-Type: application/wasm` is not
# cosmetic: the browser's streaming compiler refuses a mislabelled response
# ("Incorrect response MIME type. Expected 'application/wasm'").
/vendor/tesseract/*.wasm
  Content-Type: application/wasm
  Cache-Control: no-cache, must-revalidate

# Web App Manifest — Chrome expects a JSON MIME type before it treats the site
# as installable, so it is explicit rather than left to the extension table.
/manifest.json
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: no-cache, must-revalidate

# PWA install icons — same no-cache model as the other assets, so a regenerated
# icon is never masked by a stale cached copy.
/icons/*
  Content-Type: image/png
  Cache-Control: no-cache, must-revalidate

# /.well-known/ is the one dot-directory a CDN does serve, and it is the only
# place a Digital Asset Links file can live. The content type is not optional
# (Google's verifier rejects a file served as text/plain) and revalidating
# rather than caching means a corrected signing fingerprint takes effect on the
# next fetch instead of on the next day.
/.well-known/*
  Content-Type: application/json; charset=utf-8
  Cache-Control: no-cache, must-revalidate

# Catch-all: the security headers, and no Cache-Control — each specific rule
# above owns that for the paths it covers.
#
# X-Content-Type-Options is stated once, here, and deliberately not repeated in
# the path rules above. Cloudflare joins the headers of every rule a request
# matches rather than letting the most specific one win, so a `nosniff` in a path
# rule and in this catch-all arrive as `nosniff, nosniff` — measured on 15 Oct
# 2026 on the deployed site and reproduced through `wrangler pages dev` locally
# on `/`, `/app.js` and `/icons/icon-192.png` alike. The header was doing its job
# in both places; one statement is the whole of it.
#
#   * frame-ancestors 'none' + X-Frame-Options: DENY — the app must never be
#     iframed (clickjacking the lock screen or a destructive action). The portal
#     lists the dashboards it frames and this one is not among them, which is
#     the same choice the Irish Visa Tracker makes; adding it there later means
#     naming the portal origin here, and tools/check-embed.mjs is what notices.
#   * Content-Security-Policy — default-deny with allowances for the app's real
#     needs. script-src carries SHA-256 hashes of the five inline boot scripts
#     in index.html (theme init, chrome sync, SW register, boot-fail
#     diagnostic, splash removal); edit any of them and you MUST re-hash them
#     or the app fails to boot (check-csp-hashes.mjs fails the suite otherwise).
#     'unsafe-inline' is limited to styles, which the UI sets as attributes.
#     connect-src allows any https endpoint because the sync proxy can be
#     self-hosted on a custom domain, plus localhost for local development.
#     'wasm-unsafe-eval' is required by the Tesco Pay roster OCR: Chrome refuses
#     to instantiate the vendored WebAssembly without it, and it permits WASM
#     compilation only — no string eval. Nothing else was widened for the move:
#     img-src/media-src stay 'self' data:, which is what the app has run on.
#   * Cross-Origin-Opener-Policy + Cross-Origin-Resource-Policy — this origin
#     opens nothing and shares nothing.
#   * Permissions-Policy — every powerful feature the app never uses is denied
#     outright. camera stays (self) because the roster reader offers live
#     capture; clipboard stays at its default because the Data menu copies
#     export links.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(self), geolocation=(), microphone=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), midi=(), accelerometer=(), gyroscope=(), magnetometer=(), display-capture=(), screen-wake-lock=(), browsing-topics=(), attribution-reporting=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-rQpWdpfO3jew1iL5zZ98vGEJgNo+qkd+3CxRBjXKHX0=' 'sha256-D2LzLLViPue4ETfCdLrasOjw6uXTHzgIw0+qHJWBrQY=' 'sha256-dtIg9U8JSsmLRDU6OgsK4CDDi2w92H8NwG52SeuprU0=' 'sha256-yRwnfBx8x3rJwqu8JY9FYkEwlvyW97Jampw47u8as8o=' 'sha256-Tcie8lUtWw9EUeiQ+I8ykdJCQwFFJC8hxZPGmniSwLA='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data:; font-src 'self'; connect-src 'self' https: http://localhost:*; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

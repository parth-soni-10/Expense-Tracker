# Don't drag development-only artefacts into the Netlify deploy.
# Mirrors .gitignore plus anything that's only needed locally.

# Node unit tests live in testing/ (gitignored too) — never ship them.
# Run with `node testing/merge-test.mjs`.
testing/

# Defensive: if npm dependencies are ever reintroduced, keep them off the site.
node_modules/

# Data-shaped artefacts must never be served, even committed by accident: an
# exported CSV or a pulled cloud copy is somebody's real spending, and
# `publish = "."` would publish it at the same URL as the app. check-freshness
# catches anything else that ships without a 404 rule, but these are worth
# excluding outright because they are what a person would add by hand.
*.csv
*.xlsx
data*.json

# The Lidl spike's output folder holds real credentials, a refresh token and
# pulled receipts. It sits in the repo (so the .env template and otp.txt have
# one obvious home) but must never reach the CDN — `publish = "."` would
# otherwise serve lidl.env at a predictable URL. Gitignored too, so it cannot
# be committed; excluded here as the second, independent half.
lidl-spike-out/

# Python bytecode caches: the local scripts (lidl-spike.py, and formerly
# convert-tesco-csv.py) can leave __pycache__ behind, so it never ships.
# ocr-harness.html is belt-and-braces: it already has its own 404 rule in
# netlify.toml, and this keeps it off the upload entirely — it is opened from
# a laptop against a local http server, with the real pipeline and synthetic
# roster photos, and never from the deploy.
__pycache__/
*.pyc
ocr-harness.html
# Same treatment for the accessibility harness: it loads the app in an iframe and
# walks every route and modal, which is a thing you do against a local server.
a11y-harness.html

# Standard noise
.DS_Store
*.log
*.tlog
*.swp
*.swo
.idea/
.vscode/
.env
.env.*
